# Gabsweb CashFlow environment example.
# Copy this file to .env and fill in real values. Never commit the real .env file.

# Django. Keep true for local development; production must use false.
DJANGO_DEBUG=true

# Production-only settings (ignored while DJANGO_DEBUG=true).
# DJANGO_SECRET_KEY is mandatory in production; startup fails without it.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Comma-separated host names, e.g. cashflow.gabsweb.com.ng,www.cashflow.gabsweb.com.ng
DJANGO_ALLOWED_HOSTS=
# Comma-separated trusted HTTPS origins for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://cashflow.gabsweb.com.ng
# HTTPS and cookie hardening (defaults shown).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
# Enable HSTS only after HTTPS is verified stable. Start with 0, then raise
# (for example 31536000) once the site is confirmed working over HTTPS.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Set false only if the app is not behind a reverse proxy that sets
# X-Forwarded-Proto; otherwise HTTPS detection and redirects will break.
DJANGO_TRUST_PROXY_SSL_HEADER=true

# Database.
# Leave DJANGO_DB_ENGINE empty for local SQLite (the default development DB).
# On TrueHost set the engine to mysql and fill in the database created in cPanel.
# Do not point this at the live database from a local machine.
DJANGO_DB_ENGINE=
# MySQL 8.4 connection settings (used only when DJANGO_DB_ENGINE=mysql).
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
# Keep connections alive briefly to reduce per-request handshakes.
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=10

# Static files (WhiteNoise). Production uses hashed, compressed filenames.
# Short browser cache lifetime for non-hashed files such as the offline page.
DJANGO_STATIC_MAX_AGE=60

# Transactional email (Resend HTTPS API via django-anymail).
# Email is sent over HTTPS (port 443), never SMTP. The key is read from the
# environment only and must never be committed. Reuse the existing Resend API
# key if you have one; otherwise create a new key in the Resend dashboard.
RESEND_API_KEY=
# The verified Resend sender address.
DEFAULT_FROM_EMAIL="Gabsweb CashFlow <no-reply@cashflow.gabsweb.com.ng>"
# HTTP timeout in seconds for Resend API requests.
EMAIL_TIMEOUT=10

# Public base URL used to build password-reset links in emails.
# Local development: http://127.0.0.1:8000
# Production: https://cashflow.gabsweb.com.ng
PASSWORD_RESET_BASE_URL=http://127.0.0.1:8000

# Password-reset token lifetime in seconds (default one hour).
PASSWORD_RESET_TIMEOUT=3600

# Absolute HTTPS URL for the Gabsweb CashFlow logo shown in HTML emails.
# The approved asset lives at static/assets/images/gabsweb-cashflow-logo.png.
# It becomes externally loadable only after the deployed site serves static
# files, so this URL will not work while the app is still local.
# Leave empty to render the text-only fallback instead of a broken image.
EMAIL_LOGO_URL=https://cashflow.gabsweb.com.ng/static/assets/images/gabsweb-cashflow-logo.png

# Canonical public origin used by SEO metadata, robots.txt and sitemap.xml.
# Must be the production HTTPS origin without a trailing slash.
SITE_BASE_URL=https://cashflow.gabsweb.com.ng

# Google OAuth sign-in (django-allauth).
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console. Add the exact callback URLs you use to "Authorized redirect URIs":
#   Local:      http://127.0.0.1:8000/accounts/google/login/callback/
#   Production: https://cashflow.gabsweb.com.ng/accounts/google/login/callback/
# Add the matching site origins under "Authorized JavaScript origins".
# Leave both empty to disable Google sign-in; email/password still works.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
